# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.backup

# vibing.nvim data
.vibing/

# Generated hook registrations for the non-Claude backends, written at request time. Both
# hard-code an absolute path to the checkout that wrote them, so neither is portable.
# (the Claude equivalent lives under .vibing/, already ignored above)
.grok/
.codex/

# Serena MCP memory
.serena/

# superpowers subagent-driven-development scratch (briefs, reports, diffs, ledger)
.superpowers/

# Vim/Neovim
*.swp
*.swo
*.swn
*~
.netrwhist
tags
.tags

# Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Logs
*.log
logs/
*.err

# Environment
.env
.env.local
.env.*.local

# Build
dist/
build/
# Whole directory, not `/parser/vibing.*`: nothing here is tracked, and the pattern has to cover
# build.sh's dot-prefixed temporary file too, or an interrupted build leaves a visible stray.
/parser/
*.min.js
*.min.css

# Debug
# ルート直下のdebug/だけを対象にする。パターンだけだと
# lua/vibing/application/debug/ のような正規のソースまで飲み込む
/debug/
*.debug

# Temporary
tmp/
temp/
*.tmp
*.bak
*.backup
.worktrees
.claude-work

# Test files
*.txt
!tree-sitter-vibing/test/corpus/*.txt
final-*.md
restart-*.md
test-*.md
test-*/
