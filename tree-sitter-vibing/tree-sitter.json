{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "vibing",
      "scope": "text.vibing",
      "path": ".",
      "file-types": ["vibing"],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "injection-regex": "^vibing$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Outer chat grammar for vibing.nvim",
    "authors": [
      {
        "name": "vibing.nvim contributors"
      }
    ],
    "links": {
      "repository": "https://github.com/shabaraba/vibing.nvim"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
